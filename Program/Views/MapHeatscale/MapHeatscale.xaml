<UserControl x:Class="MEATaste.Views.MapHeatscale.ElectrodesHeatMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="465"
             IsVisibleChanged="HeatMapPanel_IsVisibleChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScottPlot:WpfPlot x:Name="PlotControl2" Grid.Row="0" Loaded="PlotControl2_Loaded" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="2">
            <Button Content="+" Width="24" Height="22" Click="ZoomIn_Click" ToolTip="Zoom in"/>
            <Button Content="−" Width="24" Height="22" Margin="2,0,0,0" Click="ZoomOut_Click" ToolTip="Zoom out"/>
            <Button Content="Fit" MinWidth="32" Height="22" Margin="2,0,0,0" Click="Fit_Click" ToolTip="Fit array"/>
        </StackPanel>
    </Grid>
</UserControl>
